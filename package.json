{
  "name": "craft-agents-learning-rebuild",
  "private": true,
  "type": "module",
  "main": "dist/main.mjs",
  "scripts": {
    "dev:ui": "vite --host 127.0.0.1",
    "build:main": "esbuild src/main.ts --bundle --platform=node --format=esm --outfile=dist/main.mjs --external:electron --external:@anthropic-ai/claude-agent-sdk --external:@earendil-works/pi-coding-agent --external:@earendil-works/pi-agent-core --external:@earendil-works/pi-ai",
    "build:preload": "esbuild src/preload.ts --bundle --platform=node --format=cjs --outfile=dist/preload.cjs --external:electron",
    "dev:desktop": "npm run build:main && npm run build:preload && electron .",
    "build:ui": "vite build"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.4.1",
    "esbuild": "^0.28.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.220",
    "@earendil-works/pi-agent-core": "^0.80.6",
    "@earendil-works/pi-ai": "^0.80.6",
    "@earendil-works/pi-coding-agent": "^0.80.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
